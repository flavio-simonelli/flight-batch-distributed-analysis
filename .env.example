# =================================================================
# SKY ANALYTICS ENGINE - ENVIRONMENT CONFIGURATION
# =================================================================

# --- INFRASTRUCTURE & DEPLOYMENT ---
# Project cluster naming
SPARK_CLUSTER_NAME=flight-analysis-cluster
# Network infrastructure tags
SUBNET_NAME=flight-analysis-subnet
SG_NAME=flight-analysis-sg
# Private DNS domain
PRIVATE_DOMAIN_NAME=flight-analysis.local
# AWS deployment parameters
SSH_KEY_NAME=flight-analysis-key
BUCKET_NAME=flight-analysis-data
# Number of Spark worker nodes
WORKER_COUNT=10

# --- INGESTION LAYER ---
NIFI_WEB_HTTP_PORT=8081
NIFI_USER=admin
NIFI_PASSWORD=password_nifi_12345
NIFI_HOST=nifi.flight-analysis.local
NIFI_WEB_PROXY_HOST=nifi.flight-analysis.local,localhost

# --- STORAGE LAYER ---
# Primary HDFS NameNode identity
HDFS_NAMENODE_HOST=hdfs-master.flight-analysis.local
HDFS_NAMENODE_PORT=54310
HDFS_WEB_UI_PORT=9870

# Object Storage (S3 compatible)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- PROCESSING LAYER ---
# Spark Cluster Master
SPARK_MASTER_HOST=spark-master.flight-analysis.local
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080
SPARK_MASTER_APPLICATION_PORT=4040

# AWS Credentials for S3/MinIO access
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_SESSION_TOKEN=

# Livy Server Configuration
AIRFLOW_CONN_LIVY_HOST=livy-airflow.flight-analysis.local
AIRFLOW_CONN_LIVY_PORT=8998

# --- PERSISTENCE LAYER ---
# Main Relational Result Database
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flight_db

# Columnar Storage
HBASE_UI_PORT=16010
HBASE_ZK_PORT=2181

# --- ORCHESTRATION LAYER ---
# User Interface and Core Service
AIRFLOW_WEB_PORT=8088
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin_password
AIRFLOW_EMAIL=admin@example.com
# System UID for Docker volume permissions
AIRFLOW_UID=50000

# Metadata Storage (Airflow internal)
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow

# Cryptographic Keys (Use python to generate unique keys)
AIRFLOW_FERNET_KEY=UL0pvwOQAM9gUevcFP_Zp5mI9X_In7kW7jMtXpD9Y5Q=
AIRFLOW_JWT_SECRET=84c7a08eb089cb78b2a7c71ea16ccfd00cce0fabcb9e92af0d4c1547fbca5fcb

# Connection strings for external systems
AIRFLOW_CONN_NIFI_HTTP=http://nifi.flight-analysis.local:8085

# --- MONITORING LAYER ---
# Redis Stack for performance metrics
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001

# Visualization Dashboard
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
