# Esempio di file di configurazione (.env.example)
# Copia questo file e rinominalo in '.env', quindi modifica i valori secondo le tue necessità.

# HDFS Configuration
HDFS_NAMENODE_HOST=master
HDFS_NAMENODE_PORT=54310
HDFS_WEB_UI_PORT=9870

# Spark Configuration
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# NiFi Configuration
NIFI_WEB_HTTP_PORT=8081
NIFI_USER=admin
NIFI_PASSWORD=prova123456789prova

# Postgres Configuration
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flight_db

# Grafana Configuration
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=prova123456789prova

# Redis Configuration
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001

# MongoDB Configuration
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=admin
MONGO_DB=flight_db

# HBase Configuration
HBASE_UI_PORT=16010
HBASE_ZK_PORT=2181

# MinIO Configuration
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Airflow Connections
# Format: AIRFLOW_CONN_<CONN_ID_UPPERCASE>=<scheme>://<login>:<password>@<host>:<port>
AIRFLOW_CONN_LIVY_DEFAULT=http://livy:8998
AIRFLOW_CONN_NIFI_HTTP=http://nifi:8085

# Airflow Configuration
AIRFLOW_WEB_PORT=8088
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=prova123456789prova
AIRFLOW_EMAIL=admin@example.com
# Generare con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Generare con: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow
# UID dell'utente host: eseguire "echo $(id -u)" per ottenere il valore
AIRFLOW_UID=50000