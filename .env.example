# Example Configuration File (.env.example)
# Copy this file to '.env' and modify values as needed.

# HDFS Configuration
HDFS_NAMENODE_HOST=master.flight-analysis.local
HDFS_NAMENODE_PORT=54310
HDFS_WEB_UI_PORT=9870

# Spark Configuration
SPARK_MASTER_HOST=master.flight-analysis.local
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# NiFi Configuration
NIFI_WEB_HTTP_PORT=8081
NIFI_USER=admin
NIFI_PASSWORD=password_nifi_12345

# Postgres Configuration (on databases node)
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flight_db

# Grafana Configuration (on metrics node)
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Redis Configuration
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001

# MongoDB Configuration (on databases node)
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=password
MONGO_DB=flight_db

# HBase Configuration (on databases node)
HBASE_UI_PORT=16010
HBASE_ZK_PORT=2181

# MinIO Configuration
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Airflow Connections
# Format: AIRFLOW_CONN_<CONN_ID_UPPERCASE>=<scheme>://<login>:<password>@<host>:<port>
AIRFLOW_CONN_LIVY_DEFAULT=http://livy:8998
AIRFLOW_CONN_NIFI_HTTP=http://nifi.flight-analysis.local:8085

# Airflow Configuration
AIRFLOW_WEB_PORT=8088
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin_password
AIRFLOW_EMAIL=admin@example.com
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow
# Host user UID: run "echo $(id -u)" to get the value
AIRFLOW_UID=50000
