# Esempio di file di configurazione (.env.example)
# Copia questo file e rinominalo in '.env', quindi modifica i valori secondo le tue necessità.

# HDFS Configuration
HDFS_NAMENODE_HOST=master
HDFS_NAMENODE_PORT=54310
HDFS_WEB_UI_PORT=9870

# Spark Configuration
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080

# NiFi Configuration
NIFI_WEB_HTTP_PORT=8081
NIFI_USER=admin
NIFI_PASSWORD=prova123456789prova

# Postgres Configuration
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sae_results_db

# Grafana Configuration
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=prova123456789prova
