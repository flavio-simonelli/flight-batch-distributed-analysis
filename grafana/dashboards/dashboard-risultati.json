      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Q1 \u2014 Ritardo Medio Mensile alla Partenza: AA vs DL",
          "description": "Confronto mensile del ritardo medio (minuti) alla partenza tra American Airlines (AA) e Delta Air Lines (DL). Solo voli non cancellati.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "PCC52D03280B7034C"
                      },
                      "spec": {
                        "dataset": "flight_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  to_char(make_date(2025, month, 1), 'Mon') AS month_label,\n  MAX(CASE WHEN carrier = 'AA' THEN ROUND(avg_delay::numeric, 1) END) AS \"AA (American Airlines)\",\n  MAX(CASE WHEN carrier = 'DL' THEN ROUND(avg_delay::numeric, 1) END) AS \"DL (Delta Air Lines)\"\nFROM monthly_performance_rdd\nGROUP BY month\nORDER BY month"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "barchart",
            "version": "13.0.1",
            "spec": {
              "options": {
                "barRadius": 0.05,
                "barWidth": 0.6,
                "fullHighlight": false,
                "groupWidth": 0.75,
                "legend": {
                  "calcs": [
                    "mean",
                    "min",
                    "max"
                  ],
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true
                },
                "orientation": "auto",
                "showValue": "always",
                "stacking": "none",
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "desc"
                },
                "xTickLabelRotation": 0,
                "xTickLabelSpacing": 0
              },
              "fieldConfig": {
                "defaults": {
