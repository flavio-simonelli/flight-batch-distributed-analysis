                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Q1 \u2014 Tasso di Cancellazione Mensile: AA vs DL",
          "description": "Percentuale mensile di voli cancellati sul totale dei voli osservati per AA e DL. Calcolata su tutti i voli (cancellati + non cancellati).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
