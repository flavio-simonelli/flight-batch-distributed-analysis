      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Q3 \u2014 Percentili Ritardo Partenza per Ora del Giorno ($TargetCarrier)",
          "description": "Distribuzione oraria del ritardo alla partenza (p25, p50, p75, p90) per le airline selezionate. Solo voli non cancellati.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "PCC52D03280B7034C"
                      },
                      "spec": {
                        "dataset": "flight_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  LPAD(hour::text, 2, '0') || ':00' AS hour_label,\n  MAX(CASE WHEN \"opUniqueCarrier\" = 'AA' THEN ROUND(p25::numeric,1) END) AS \"AA p25\",\n  MAX(CASE WHEN \"opUniqueCarrier\" = 'AA' THEN ROUND(p50::numeric,1) END) AS \"AA p50\",\n  MAX(CASE WHEN \"opUniqueCarrier\" = 'AA' THEN ROUND(p75::numeric,1) END) AS \"AA p75\",\n  MAX(CASE WHEN \"opUniqueCarrier\" = 'AA' THEN ROUND(p90::numeric,1) END) AS \"AA p90\",\n  MAX(CASE WHEN \"opUniqueCarrier\" = 'DL' THEN ROUND(p25::numeric,1) END) AS \"DL p25\",\n  MAX(CASE WHEN \"opUniqueCarrier\" = 'DL' THEN ROUND(p50::numeric,1) END) AS \"DL p50\",\n  MAX(CASE WHEN \"opUniqueCarrier\" = 'DL' THEN ROUND(p75::numeric,1) END) AS \"DL p75\",\n  MAX(CASE WHEN \"opUniqueCarrier\" = 'DL' THEN ROUND(p90::numeric,1) END) AS \"DL p90\",\n  MAX(CASE WHEN \"opUniqueCarrier\" = 'UA' THEN ROUND(p25::numeric,1) END) AS \"UA p25\",\n  MAX(CASE WHEN \"opUniqueCarrier\" = 'UA' THEN ROUND(p50::numeric,1) END) AS \"UA p50\",\n  MAX(CASE WHEN \"opUniqueCarrier\" = 'UA' THEN ROUND(p75::numeric,1) END) AS \"UA p75\",\n  MAX(CASE WHEN \"opUniqueCarrier\" = 'UA' THEN ROUND(p90::numeric,1) END) AS \"UA p90\",\n  MAX(CASE WHEN \"opUniqueCarrier\" = 'WN' THEN ROUND(p25::numeric,1) END) AS \"WN p25\",\n  MAX(CASE WHEN \"opUniqueCarrier\" = 'WN' THEN ROUND(p50::numeric,1) END) AS \"WN p50\",\n  MAX(CASE WHEN \"opUniqueCarrier\" = 'WN' THEN ROUND(p75::numeric,1) END) AS \"WN p75\",\n  MAX(CASE WHEN \"opUniqueCarrier\" = 'WN' THEN ROUND(p90::numeric,1) END) AS \"WN p90\"\nFROM hourly_delay_percentiles_rdd_1\nWHERE \"opUniqueCarrier\" IN ($TargetCarrier)\nGROUP BY hour\nORDER BY hour"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "barchart",
            "version": "13.0.1",
            "spec": {
              "options": {
                "barRadius": 0.03,
                "barWidth": 0.7,
                "fullHighlight": false,
                "groupWidth": 0.85,
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "right",
                  "showLegend": true
                },
                "orientation": "auto",
                "showValue": "never",
                "stacking": "none",
                "tooltip": {
                  "hideZeros": true,
                  "mode": "multi",
                  "sort": "desc"
                },
                "xTickLabelRotation": 0,
                "xTickLabelSpacing": 0
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "decimals": 1,
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisBorderShow": false,
                    "axisCenteredZero": false,
                    "axisColorMode": "text",
                    "axisLabel": "Ritardo (min)",
                    "axisPlacement": "auto",
                    "fillOpacity": 75,
                    "gradientMode": "none",
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "lineWidth": 0,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".*p25"
                    },
                    "properties": [
                      {
                        "id": "custom.fillOpacity",
                        "value": 40
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".*p50"
                    },
                    "properties": [
                      {
                        "id": "custom.fillOpacity",
                        "value": 65
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".*p75"
                    },
                    "properties": [
                      {
                        "id": "custom.fillOpacity",
                        "value": 80
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".*p90"
                    },
                    "properties": [
                      {
                        "id": "custom.fillOpacity",
                        "value": 100
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "AA.*"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "blue",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "DL.*"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "green",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "UA.*"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "orange",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "WN.*"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "red",
                          "mode": "fixed"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-6": {
