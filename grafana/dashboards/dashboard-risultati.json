      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Q2 — Average Contribution of Delay Causes by Airline",
          "description": "Percentage breakdown of delay causes for the top 10 airlines. Missing component values are treated as 0.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "postgres-datasource-uid"
                      },
                      "spec": {
                        "dataset": "flight_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  carrier,\n  ROUND(avg_carrier_delay::numeric, 2) AS \"Carrier\",\n  ROUND(avg_weather_delay::numeric, 2) AS \"Weather\",\n  ROUND(avg_nas_delay::numeric, 2) AS \"NAS\",\n  ROUND(avg_security_delay::numeric, 2) AS \"Security\",\n  ROUND(avg_late_aircraft_delay::numeric, 2) AS \"Late Aircraft\"\nFROM arrival_delay_ranking_rdd\nORDER BY avg_arr_delay DESC\nLIMIT 10"
