              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Q2 — Top 10 Airlines by Average Arrival Delay",
          "description": "Ranking of the 10 airlines with the highest average arrival delay (minutes). Only non-cancelled and non-diverted flights with at least 500 valid flights.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "postgres-datasource-uid"
                      },
                      "spec": {
                        "dataset": "flight_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT carrier, ROUND(avg_arr_delay::numeric, 2) AS avg_arr_delay\nFROM arrival_delay_ranking_rdd\nORDER BY avg_arr_delay DESC\nLIMIT 10"
                      }
