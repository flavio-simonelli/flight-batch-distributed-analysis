    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Q1 — Average Monthly Departure Delay: AA vs DL",
          "description": "Monthly comparison of average departure delay (minutes) between American Airlines (AA) and Delta Air Lines (DL). Only non-cancelled flights.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "postgres-datasource-uid"
                      },
                      "spec": {
                        "dataset": "flight_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  to_char(make_date(2025, month, 1), 'Mon') AS month_label,\n  MAX(CASE WHEN carrier = 'AA' THEN ROUND(avg_delay::numeric, 1) END) AS \"AA (American Airlines)\",\n  MAX(CASE WHEN carrier = 'DL' THEN ROUND(avg_delay::numeric, 1) END) AS \"DL (Delta Air Lines)\"\nFROM monthly_performance_rdd\nGROUP BY month\nORDER BY month"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "barchart",
            "version": "13.0.1",
            "spec": {
              "options": {
                "barRadius": 0.05,
                "barWidth": 0.6,
                "fullHighlight": false,
                "groupWidth": 0.75,
                "legend": {
                  "calcs": [
                    "mean",
                    "min",
                    "max"
                  ],
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true
                },
                "orientation": "auto",
                "showValue": "always",
                "stacking": "none",
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "desc"
                },
                "xTickLabelRotation": 0,
                "xTickLabelSpacing": 0
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "decimals": 1,
                  "min": 0,
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisBorderShow": false,
                    "axisCenteredZero": false,
                    "axisColorMode": "text",
                    "axisLabel": "Average delay (min)",
                    "axisPlacement": "auto",
                    "fillOpacity": 80,
                    "gradientMode": "opacity",
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "lineWidth": 1,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Q1 — Monthly Cancellation Rate: AA vs DL",
          "description": "Monthly percentage of cancelled flights out of total observed flights for AA and DL. Calculated on all flights (cancelled + non-cancelled).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "postgres-datasource-uid"
                      },
                      "spec": {
                        "dataset": "flight_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  to_char(make_date(2025, month, 1), 'Mon') AS month_label,\n  MAX(CASE WHEN carrier = 'AA' THEN ROUND(cancellation_rate::numeric, 2) END) AS \"AA (American Airlines)\",\n  MAX(CASE WHEN carrier = 'DL' THEN ROUND(cancellation_rate::numeric, 2) END) AS \"DL (Delta Air Lines)\"\nFROM monthly_performance_rdd\nGROUP BY month\nORDER BY month"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
