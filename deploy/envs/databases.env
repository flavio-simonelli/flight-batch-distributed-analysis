# --- 4. PERSISTENCE LAYER (Result Databases) ---
# Postgres (Main Result DB)
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flight_db

# MongoDB
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=password
