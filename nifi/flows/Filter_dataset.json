{"flowContents":{"identifier":"58d50ac1-9e4e-3d9d-80d7-8029c5a702d3","instanceIdentifier":"41b77d6a-019e-1000-5413-d83038bd2ef1","name":"Filter_dataset","comments":"","position":{"x":120.0,"y":512.0},"processGroups":[],"remoteProcessGroups":[],"processors":[{"identifier":"c8ad1d39-ec66-3831-94c4-c2e3a046ceb5","instanceIdentifier":"42255bb6-019e-1000-cfd4-381ec9c9666e","name":"ScriptedTransformRecord","comments":"","position":{"x":-240.0,"y":-240.0},"type":"org.apache.nifi.processors.script.ScriptedTransformRecord","bundle":{"group":"org.apache.nifi","artifact":"nifi-scripting-nar","version":"2.9.0"},"properties":{"Script File":null,"Script Engine":"Groovy","Script Body":"import java.text.SimpleDateFormat\n\ndef sdf = new SimpleDateFormat(\"HHmm\")\n\n// 1. PADDING ORARI: Aggiunge gli zeri a sinistra\ndef timeFields = [\"DEP_TIME\", \"CRS_DEP_TIME\", \"ARR_TIME\", \"CRS_ARR_TIME\"]\ntimeFields.each { field ->\n    def val = record.getAsString(field)\n    if (val != null && val.trim().length() > 0) {\n        // Se c'è una stringa anomala \"2400.0\" la tronca a \"2400\", altrimenti fa solo il padding\n        val = val.contains(\".\") ? val.substring(0, val.indexOf(\".\")) : val\n        record.setValue(field, val.trim().padLeft(4, '0'))\n    }\n}\n\n// 2. CORREZIONE ANOMALIE: Porta a 0 i ritardi negativi\ndef delayFields = [\"CARRIER_DELAY\", \"WEATHER_DELAY\", \"NAS_DELAY\", \"SECURITY_DELAY\", \"LATE_AIRCRAFT_DELAY\"]\ndelayFields.each { field ->\n    def val = record.getValue(field)\n    if (val != null && ((Number) val).doubleValue() < 0) {\n        record.setValue(field, 0.0d)\n    }\n}\n\n// 3. CALCOLO RITARDI MANCANTI (Con gestione mezzanotte)\ndef calcDelay = { actualStr, scheduledStr ->\n    // Controllo di sicurezza: se mancano o non sono lunghi 4 caratteri, scarta il calcolo\n    if (!actualStr || !scheduledStr || actualStr.length() != 4 || scheduledStr.length() != 4) return null\n    \n    try {\n        int aH = actualStr.substring(0, 2).toInteger()\n        int aM = actualStr.substring(2, 4).toInteger()\n        int sH = scheduledStr.substring(0, 2).toInteger()\n        int sM = scheduledStr.substring(2, 4).toInteger()\n        \n        // Nel mondo dell'aviazione la mezzanotte è spesso scritta come 2400. La convertiamo in 0000.\n        if (aH == 24) { aH = 0; aM = 0 }\n        if (sH == 24) { sH = 0; sM = 0 }\n        \n        int actualMins = (aH * 60) + aM\n        int schedMins = (sH * 60) + sM\n        \n        double diff = actualMins - schedMins\n        \n        // Gestione asimmetrica dello scavallamento della mezzanotte\n        // Assumiamo che un volo possa partire al massimo con 2 ORE di anticipo (-120 min)\n        // e con un ritardo massimo di 22 ORE (+1320 min)\n        if (diff < -120) {\n            diff += 1440.0 // Il volo era atteso alle 23:50 ed è partito alle 00:15 (diff grezza: -1415 -> +25)\n        } else if (diff > 1320) {\n            diff -= 1440.0 // Il volo era atteso alle 00:10 ed è partito alle 23:55 (diff grezza: +1425 -> -15)\n        }\n        \n        return diff\n    } catch (Exception e) {\n        return null // Protezione totale da stringhe impreviste (\"abcd\")\n    }\n}\n\ndef cancelled = record.getValue(\"CANCELLED\")\nif (cancelled != null && ((Number) cancelled).doubleValue() == 0.0) {\n    \n    if (record.getValue(\"DEP_DELAY\") == null) {\n        def delay = calcDelay(record.getAsString(\"DEP_TIME\"), record.getAsString(\"CRS_DEP_TIME\"))\n        if (delay != null) record.setValue(\"DEP_DELAY\", delay)\n    }\n    \n    if (record.getValue(\"ARR_DELAY\") == null) {\n        def delay = calcDelay(record.getAsString(\"ARR_TIME\"), record.getAsString(\"CRS_ARR_TIME\"))\n        if (delay != null) record.setValue(\"ARR_DELAY\", delay)\n    }\n}\n\nreturn record","Record Writer":"e3653dfc-a0c2-3cfc-ad0a-34abb3c2d2db","Record Reader":"e6ab7998-667b-38e3-a8ba-8ab227224b7d","Module Directory":null},"propertyDescriptors":{"Script File":{"name":"Script File","displa